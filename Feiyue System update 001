                    placeholder="Tìm theo ID...">
            </div>

            <div id="memberList" class="space-y-3 max-h-96 overflow-y-auto">
            </div>

            <button onclick="document.getElementById('memberListModal').classList.add('hidden')"
                class="w-full btn-cyber-outline py-2 rounded-lg text-sm mt-4">Đóng</button>
        </div>
    </div>

    <div id="employeeHistoryModal" class="modal">
        <div class="modal-content p-6 rounded-xl w-full max-w-4xl border-cyan-400/50 shadow-2xl space-y-4">
