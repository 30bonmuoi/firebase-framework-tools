            </div>

            <div class="grid grid-cols-2 gap-4">
                <div class="space-y-3">
                    <h3 class="text-xl font-bold text-red-400 border-b border-red-600 pb-1">Lịch Sử Vi Phạm</h3>
                    <div id="historyViolations" class="max-h-60 overflow-y-auto space-y-2"></div>
                </div>
