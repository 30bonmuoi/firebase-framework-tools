<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FEIYUE INTERNAL SYSTEM v2.5</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* --- CYBER THEME CSS --- */
        body {
            font-family: 'Inter', sans-serif;
            background-color: #000;
            color: #fff;
            overflow: hidden;
        }

        /* Matrix Canvas */
        #matrixCanvas {
            position: fixed;
            top: 0;
            left: 0;
            z-index: -1;
        }

        /* Neon Text Effect */
        .neon-text {
            text-shadow: 0 0 5px currentColor, 0 0 10px currentColor;
        }

        /* Cyber Button Style */
        .btn-cyber {
            background-color: #00ffc8;
            /* Neon Cyan */
            color: #000;
            font-weight: bold;
            border: 2px solid #00ffc8;
            box-shadow: 0 0 5px #00ffc8;
            transition: all 0.15s;
        }

        .btn-cyber:hover {
            box-shadow: 0 0 10px #00ffc8, 0 0 20px #00ffc8;
            transform: translateY(-1px);
        }

        .btn-cyber-outline {
            background-color: transparent;
            color: #00ffc8;
            border: 2px solid #00ffc8;
            box-shadow: 0 0 5px #00ffc8;
        }

        .btn-cyber-outline:hover {
            background-color: #00ffc81a;
        }

        /* Input Style */
        .input-cyber {
            background-color: #1f2937;
            border: 1px solid #4b5563;
            color: #fff;
            padding: 0.5rem 1rem;
            border-radius: 0.5rem;
            transition: all 0.2s;
            font-family: monospace;
            -webkit-appearance: none;
            -moz-appearance: none;
            appearance: none;
        }

        .input-cyber:focus {
            outline: none;
            border-color: #00ffc8;
            box-shadow: 0 0 5px #00ffc8;
        }

        /* Modal/Panel Cyber Border */
        .cyber-border {
            border: 2px solid;
            box-shadow: 0 0 15px rgba(0, 255, 200, 0.3);
        }

        .modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.8);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 100;
        }

        .modal-content {
            background-color: #111827;
            border: 2px solid;
        }

        /* Toast Notification */
        #toast-notification {
            position: fixed;
            bottom: 20px;
            right: 20px;
            padding: 10px 20px;
            border-radius: 8px;
            display: none;
            opacity: 0;
            transition: opacity 0.3s;
            font-weight: bold;
            z-index: 1000;
            background-color: #1f2937;
        }

        /* Scroll Text for Banner */
        .scrolling-text {
            animation: scroll-left 25s linear infinite;
        }

        @keyframes scroll-left {
            0% {
                transform: translateX(100%);
            }

            100% {
                transform: translateX(-100%);
            }
        }

        /* Chat Widget */
        #chat-widget {
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index: 50;
        }

        #chat-button {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background-color: #00ffc8;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            box-shadow: 0 0 10px #00ffc8;
        }

        #chat-panel {
            position: absolute;
            bottom: 70px;
            right: 0;
            width: 300px;
            height: 400px;
            background-color: #000;
            border: 2px solid #00ffc8;
            border-radius: 8px;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            transition: transform 0.3s ease-in-out, opacity 0.3s ease-in-out;
            transform: translateY(100%);
            opacity: 0;
        }

        #chat-messages {
            flex-grow: 1;
            overflow-y: auto;
            padding: 10px;
            background-color: #000;
            border-bottom: 1px solid #00ffc8;
        }

        .message.ai {
            color: #00ffc8;
            text-align: left;
        }

        .message.user {
            color: #fff;
            text-align: right;
        }
    </style>
</head>

